# ========================================================
# Zulaid Chaudhary Foundation - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ========================================================

# APP CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SITE_NAME="Zulaid Chaudhary Foundation"

# DATABASE (PostgreSQL - Neon / Supabase / Local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/zcf_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/zcf_db?schema=public"

# AUTH.JS (NEXTAUTH)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-32-byte-base64-secret-here"

# ADMINISTRATIVE 2FA ENCRYPTION KEY (32-byte hex string)
ENCRYPTION_KEY_2FA="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# PAYMENT GATEWAYS (TEST MODE ONLY - NO REAL KEYS)
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_key"

# TRANSACTIONAL EMAIL (Resend / Mock Adapter)
EMAIL_PROVIDER="mock" # Set to 'resend' in production
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="Zulaid Chaudhary Foundation <no-reply@zulaidchaudharyfoundation.com>"

# OBJECT STORAGE (AWS S3 / Cloudflare R2 / Local Disk)
STORAGE_PROVIDER="local" # Set to 's3' in production
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="placeholder_aws_key"
AWS_SECRET_ACCESS_KEY="placeholder_aws_secret"
AWS_S3_BUCKET_PUBLIC="zcf-public-assets"
AWS_S3_BUCKET_PRIVATE="zcf-private-vault"

# SYSTEM SAFETY & ETHICAL FLAGS
NEXT_PUBLIC_IS_DEMO_ENVIRONMENT="true"
NEXT_PUBLIC_LEGAL_STATUS_OVERRIDE="Registration in progress"
